<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.brewlint</groupId>
    <artifactId>brewlint-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>brewlint-report</artifactId>
  <name>Brewlint :: Report</name>
  <description>Report rendering. The ReportRenderer contract lives here; the terminal implementation ships in Hito 1, the PDF one in Hito 5.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.brewlint</groupId>
      <artifactId>brewlint-core</artifactId>
    </dependency>
    <!-- Hito 5. HTML is laid out by this library and turned into a PDF by PDFBox, rather than
         placing every line of text by hand. Code excerpts need real font metrics to wrap and to
         keep a monospace column aligned, and PDFBox brings that measurement with it. -->
    <dependency>
      <groupId>com.openhtmltopdf</groupId>
      <artifactId>openhtmltopdf-pdfbox</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>
</project>
