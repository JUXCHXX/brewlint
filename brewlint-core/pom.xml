<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.brewlint</groupId>
    <artifactId>brewlint-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>brewlint-core</artifactId>
  <name>Brewlint :: Core</name>
  <description>Parser, rule engine, rule plugin contract and finding model. No terminal, no PDF, no CLI.</description>

  <dependencies>
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <!-- Only the version stamp is filtered. Filtering every resource would mangle
           META-INF/services entries, which are read as plain text by ServiceLoader. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>brewlint-version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>brewlint-version.properties</exclude>
        </excludes>
      </resource>
    </resources>
  </build>
</project>
